# ==============================================================================
# HEIDI SYSTEMS B2B LEAD GENERATOR - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.

# --- LLM Provider Configuration (Default: DeepSeek) ---
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional fallback if using OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Web Search Discovery (Supports: auto, tavily, exa, brave, duckduckgo) ---
# Set SEARCH_PROVIDER=auto to automatically use Tavily, Exa, Brave, or free keyless DuckDuckGo/Directory search
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
BRAVE_RESULTS_PER_QUERY=20
MAX_SEARCH_QUERIES=8

# --- Scraping & Rate Limiting ---
HTTP_TIMEOUT_SECONDS=15
MAX_SUBPAGES_PER_COMPANY=5
REQUEST_DELAY_SECONDS=1.0
USER_AGENT=HeidiLeadResearchBot/1.0 (+https://heidisystems.com; B2B Market Research)

# --- Storage & Persistence ---
# Modes: "json" (default local persistence) or "mongodb"
STORAGE_BACKEND=json
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=heidi_b2b_leads

# --- Paths ---
DATA_DIR=data
CACHE_DIR=data/cache
OUTPUT_DIR=data/output
KPI_CONFIG_PATH=config/kpi_weights.yaml
